    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "less": "^4.4.2",
    "mockjs-extend": "^1.9.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "sass": "^1.94.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
